<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Portal CTBJ</title>
<style>
:root{
  --bg:#f4f6f8; --card:#ffffff; --text:#1a1f27; --muted:#5b6572;
  --accent:#2563eb; --accent-dark:#1d4ed8; --border:#e2e6ea;
  --warn:#f59e0b; --ok:#16a34a; --danger:#dc2626;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0f1319; --card:#171c24; --text:#eef1f5; --muted:#9aa4b2;
    --accent:#3b82f6; --accent-dark:#60a5fa; --border:#262d38;
  }
}
:root[data-theme="dark"]{
  --bg:#0f1319; --card:#171c24; --text:#eef1f5; --muted:#9aa4b2;
  --accent:#3b82f6; --accent-dark:#60a5fa; --border:#262d38;
}
html{scroll-padding-top:env(safe-area-inset-top,0px); height:100%;}
*{box-sizing:border-box;}
body{
  margin:0; height:100%; background:var(--bg); color:var(--text);
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
}
header{
  position:sticky; top:0; top:env(safe-area-inset-top,0px);
  background:var(--accent); color:#fff; padding:16px 20px;
  padding-top:calc(16px + env(safe-area-inset-top,0px));
  display:flex; align-items:center; justify-content:space-between; gap:12px;
  z-index:10;
}
header h1{font-size:1.05rem; margin:0; font-weight:600;}
header .sub{font-size:.75rem; opacity:.85;}
nav{
  display:flex; gap:4px; padding:8px 12px; background:var(--card);
  border-bottom:1px solid var(--border); overflow-x:auto;
}
nav button{
  border:none; background:transparent; color:var(--muted); padding:10px 14px;
  border-radius:8px; font-size:.85rem; font-weight:600; cursor:pointer; white-space:nowrap;
}
nav button.active{background:var(--accent); color:#fff;}
main{max-width:760px; margin:0 auto; padding:16px; padding-bottom:60px;}
.view{display:none;}
.view.active{display:block;}
.card{
  background:var(--card); border:1px solid var(--border); border-radius:12px;
  padding:16px; margin-bottom:14px;
}
.card h3{margin:0 0 4px; font-size:1rem;}
.card .meta{font-size:.75rem; color:var(--muted); margin-bottom:8px;}
.card p{margin:0; font-size:.9rem; line-height:1.4;}
.tag{
  display:inline-block; font-size:.7rem; font-weight:700; padding:2px 8px;
  border-radius:999px; margin-right:6px; text-transform:uppercase;
}
.tag.urgente{background:#fee2e2; color:var(--danger);}
.tag.aviso{background:#dbeafe; color:var(--accent-dark);}
.tag.comissao{background:#fef3c7; color:#92400e;}
form{display:flex; flex-direction:column; gap:10px;}
label{font-size:.8rem; font-weight:600; color:var(--muted);}
input, textarea, select{
  width:100%; padding:10px; border-radius:8px; border:1px solid var(--border);
  background:var(--bg); color:var(--text); font-size:.9rem; font-family:inherit;
}
textarea{resize:vertical; min-height:60px;}
button.primary{
  background:var(--accent); color:#fff; border:none; padding:11px 16px;
  border-radius:8px; font-weight:700; font-size:.9rem; cursor:pointer;
}
button.primary:active{background:var(--accent-dark);}
button.small{
  background:transparent; border:1px solid var(--border); color:var(--muted);
  padding:6px 10px; border-radius:6px; font-size:.75rem; cursor:pointer;
}
.empty{color:var(--muted); font-size:.85rem; text-align:center; padding:30px 10px;}
.badge-count{
  background:#fff; color:var(--accent); border-radius:999px; font-size:.7rem;
  padding:1px 7px; font-weight:800; margin-left:4px;
}
.row{display:flex; gap:10px;}
.row > *{flex:1;}
h2.section-title{font-size:.95rem; margin:4px 0 12px; color:var(--muted); font-weight:700; text-transform:uppercase; letter-spacing:.03em;}
</style>
</head>
<body>

<header>
  <div>
    <h1>Portal CTBJ</h1>
    <div class="sub">Avisos · Reuniões · Comissões</div>
  </div>
  <div id="userBadge" class="sub"></div>
</header>

<nav>
  <button data-view="avisos" class="active">Avisos<span class="badge-count" id="countAvisos">0</span></button>
  <button data-view="reunioes">Reuniões<span class="badge-count" id="countReunioes">0</span></button>
  <button data-view="comissoes">Comissões<span class="badge-count" id="countComissoes">0</span></button>
</nav>

<main>

  <section id="view-avisos" class="view active">
    <h2 class="section-title">Publicar aviso</h2>
    <div class="card">
      <form id="formAviso">
        <label>Título</label>
        <input type="text" id="avisoTitulo" required placeholder="Ex: Suspensão de aulas na sexta-feira">
        <label>Mensagem</label>
        <textarea id="avisoMsg" required placeholder="Detalhes do aviso..."></textarea>
        <div class="row">
          <div>
            <label>Prioridade</label>
            <select id="avisoPrioridade">
              <option value="aviso">Normal</option>
              <option value="urgente">Urgente</option>
            </select>
          </div>
          <div>
            <label>Destinado a</label>
            <select id="avisoPublico">
              <option value="Todos">Todos</option>
              <option value="Professores">Professores</option>
              <option value="Alunos">Alunos</option>
              <option value="Responsáveis">Responsáveis</option>
            </select>
          </div>
        </div>
        <button type="submit" class="primary">Publicar aviso</button>
      </form>
    </div>

    <h2 class="section-title">Avisos publicados</h2>
    <div id="listaAvisos"></div>
  </section>

  <section id="view-reunioes" class="view">
    <h2 class="section-title">Marcar reunião</h2>
    <div class="card">
      <form id="formReuniao">
        <label>Assunto</label>
        <input type="text" id="reuniaoAssunto" required placeholder="Ex: Conselho de classe - 2º ano">
        <div class="row">
          <div>
            <label>Data</label>
            <input type="date" id="reuniaoData" required>
          </div>
          <div>
            <label>Horário</label>
            <input type="time" id="reuniaoHora" required>
          </div>
        </div>
        <label>Local</label>
        <input type="text" id="reuniaoLocal" placeholder="Ex: Sala de reuniões / Google Meet">
        <label>Participantes</label>
        <input type="text" id="reuniaoParticipantes" placeholder="Ex: Coordenação, Professores do 2º ano">
        <button type="submit" class="primary">Agendar reunião</button>
      </form>
    </div>

    <h2 class="section-title">Reuniões agendadas</h2>
    <div id="listaReunioes"></div>
  </section>

  <section id="view-comissoes" class="view">
    <h2 class="section-title">Indicar professor para comissão</h2>
    <div class="card">
      <form id="formComissao">
        <label>Nome do professor</label>
        <input type="text" id="comissaoProfessor" required placeholder="Ex: Prof. João Silva">
        <label>Comissão</label>
        <input type="text" id="comissaoNome" required placeholder="Ex: Comissão de Formatura 2027">
        <label>Observação (opcional)</label>
        <textarea id="comissaoObs" placeholder="Motivo da indicação, prazo, etc."></textarea>
        <button type="submit" class="primary">Enviar indicação</button>
      </form>
    </div>

    <h2 class="section-title">Indicações enviadas</h2>
    <div id="listaComissoes"></div>
  </section>

</main>

<script>
const STORAGE_KEY = 'portal-escola-data-v1';

function loadData(){
  try{
    const raw = localStorage.getItem(STORAGE_KEY);
    if(raw) return JSON.parse(raw);
  }catch(e){ console.warn('Falha ao ler storage', e); }
  return { avisos: [], reunioes: [], comissoes: [] };
}
function saveData(data){
  try{ localStorage.setItem(STORAGE_KEY, JSON.stringify(data)); }
  catch(e){ console.warn('Falha ao salvar storage', e); }
}

let data = loadData();

function fmtData(iso){
  if(!iso) return '';
  const [y,m,d] = iso.split('-');
  return `${d}/${m}/${y}`;
}
function fmtDataHora(ts){
  const d = new Date(ts);
  return d.toLocaleString('pt-BR', {day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit'});
}

document.querySelectorAll('nav button').forEach(btn=>{
  btn.addEventListener('click', ()=>{
    document.querySelectorAll('nav button').forEach(b=>b.classList.remove('active'));
    document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('view-'+btn.dataset.view).classList.add('active');
  });
});

document.getElementById('formAviso').addEventListener('submit', e=>{
  e.preventDefault();
  data.avisos.unshift({
    id: Date.now(),
    titulo: document.getElementById('avisoTitulo').value,
    mensagem: document.getElementById('avisoMsg').value,
    prioridade: document.getElementById('avisoPrioridade').value,
    publico: document.getElementById('avisoPublico').value,
    data: Date.now()
  });
  saveData(data);
  e.target.reset();
  renderAvisos();
});

function renderAvisos(){
  const list = document.getElementById('listaAvisos');
  document.getElementById('countAvisos').textContent = data.avisos.length;
  if(data.avisos.length===0){
    list.innerHTML = '<div class="empty">Nenhum aviso publicado ainda.</div>';
    return;
  }
  list.innerHTML = data.avisos.map(a=>`
    <div class="card">
      <span class="tag ${a.prioridade}">${a.prioridade==='urgente'?'Urgente':'Aviso'}</span>
      <span class="tag" style="background:var(--bg); color:var(--muted);">${a.publico}</span>
      <h3>${escapeHtml(a.titulo)}</h3>
      <div class="meta">${fmtDataHora(a.data)}</div>
      <p>${escapeHtml(a.mensagem)}</p>
    </div>
  `).join('');
}

document.getElementById('formReuniao').addEventListener('submit', e=>{
  e.preventDefault();
  data.reunioes.push({
    id: Date.now(),
    assunto: document.getElementById('reuniaoAssunto').value,
    data: document.getElementById('reuniaoData').value,
    hora: document.getElementById('reuniaoHora').value,
    local: document.getElementById('reuniaoLocal').value,
    participantes: document.getElementById('reuniaoParticipantes').value
  });
  data.reunioes.sort((a,b)=> (a.data+a.hora).localeCompare(b.data+b.hora));
  saveData(data);
  e.target.reset();
  renderReunioes();
});

function renderReunioes(){
  const list = document.getElementById('listaReunioes');
  document.getElementById('countReunioes').textContent = data.reunioes.length;
  if(data.reunioes.length===0){
    list.innerHTML = '<div class="empty">Nenhuma reunião agendada ainda.</div>';
    return;
  }
  list.innerHTML = data.reunioes.map(r=>`
    <div class="card">
      <h3>${escapeHtml(r.assunto)}</h3>
      <div class="meta">${fmtData(r.data)} às ${r.hora}${r.local? ' · '+escapeHtml(r.local):''}</div>
      ${r.participantes? `<p><strong>Participantes:</strong> ${escapeHtml(r.participantes)}</p>` : ''}
    </div>
  `).join('');
}

document.getElementById('formComissao').addEventListener('submit', e=>{
  e.preventDefault();
  data.comissoes.unshift({
    id: Date.now(),
    professor: document.getElementById('comissaoProfessor').value,
    comissao: document.getElementById('comissaoNome').value,
    obs: document.getElementById('comissaoObs').value,
    data: Date.now()
  });
  saveData(data);
  e.target.reset();
  renderComissoes();
});

function renderComissoes(){
  const list = document.getElementById('listaComissoes');
  document.getElementById('countComissoes').textContent = data.comissoes.length;
  if(data.comissoes.length===0){
    list.innerHTML = '<div class="empty">Nenhuma indicação enviada ainda.</div>';
    return;
  }
  list.innerHTML = data.comissoes.map(c=>`
    <div class="card">
      <span class="tag comissao">Indicação</span>
      <h3>${escapeHtml(c.professor)} → ${escapeHtml(c.comissao)}</h3>
      <div class="meta">${fmtDataHora(c.data)}</div>
      ${c.obs? `<p>${escapeHtml(c.obs)}</p>` : ''}
    </div>
  `).join('');
}

function escapeHtml(str){
  const div = document.createElement('div');
  div.textContent = str;
  return div.innerHTML;
}

renderAvisos();
renderReunioes();
renderComissoes();
</script>

</body>
</html>
